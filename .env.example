# OmniStream configuration.
# Copy to .env (or run `make init-env`, which generates the secrets for you).
# .env is gitignored. Never commit real values.

# ---------------------------------------------------------------- required ----
# Fernet key used to encrypt stream keys / OAuth tokens at rest.
# Generate: make secret   (rotation: comma-separated list, first key is primary)
OMNI_SECRET_KEY=

# Random secret used to sign the dashboard session cookie.  Generate: make secret
OMNI_SESSION_SECRET=

# Single admin user for the dashboard + API.
OMNI_ADMIN_USERNAME=admin
# Either a plaintext password (hashed with argon2 in memory at startup) ...
OMNI_ADMIN_PASSWORD=
# ... or, preferably, an argon2 PHC hash.  Generate: make hash-password
OMNI_ADMIN_PASSWORD_HASH=

# Secret stream key OBS must use. Publish to rtmp://<host>:1935/live/<key>
# (OBS: server rtmp://<host>:1935/live, stream key <key>).  Generate: make secret
OMNI_INGEST_STREAM_KEY=

# -------------------------------------------------------------------- edge ----
# Public hostname for Caddy. `localhost` => self-signed internal CA.
# A real DNS name pointing at this VM => automatic Let's Encrypt HTTPS.
OMNI_DOMAIN=localhost

# ---------------------------------------------------------------- optional ----
OMNI_LOG_LEVEL=info
# json (production) | console (human readable)
OMNI_LOG_FORMAT=json
# Session cookie lifetime in seconds (default 30 days; owner mostly uses a phone).
OMNI_SESSION_MAX_AGE=2592000
# auto => Secure flag only when the request arrived over HTTPS. always | never.
OMNI_COOKIE_SECURE=auto

# Internal service URLs. Defaults match docker-compose.yml; override only for
# local development outside Docker.
#OMNI_DATABASE_URL=sqlite:////data/omnistream.db
#OMNI_REDIS_URL=redis://redis:6379/0
#OMNI_MEDIAMTX_API_URL=http://mediamtx:9997
#OMNI_MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554
